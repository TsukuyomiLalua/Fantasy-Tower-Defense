/* Mobile-first 9:16 layout with strict horizontal overflow guard */
*, *::before, *::after {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  max-width: 100vw;
  height: 100%;
  overflow: hidden;
  background: #0d121a;
  color: #eef3fb;
  font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
  touch-action: manipulation;
}

.app-shell {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100vw;
  height: 100dvh;
  overflow: hidden;
  position: relative;
}

.top-hud {
  flex: 0 0 auto;
  padding: 6px 8px;
  background: rgba(16, 23, 34, 0.94);
  border-bottom: 1px solid rgba(148, 178, 224, 0.18);
  display: flex;
  flex-direction: column;
  gap: 5px;
  z-index: 10;
}

.hud-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 5px;
  width: 100%;
}

.hud-pill {
  background: rgba(28, 39, 58, 0.9);
  border: 1px solid rgba(148, 178, 224, 0.2);
  border-radius: 8px;
  padding: 4px 6px;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.hud-pill .lbl {
  font-size: 10px;
  color: #9cb0cf;
  line-height: 1.1;
  white-space: nowrap;
}

.hud-pill .val {
  font-size: 12px;
  font-weight: 700;
  color: #f8fbff;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stage-wrap {
  flex: 1 1 auto;
  position: relative;
  width: 100%;
  min-height: 0;
  overflow: hidden;
  background: #14202b;
}

.game-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.perf-badge {
  position: absolute;
  top: 8px;
  right: 8px;
  max-width: calc(100% - 16px);
  padding: 3px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  background: rgba(12, 18, 28, 0.78);
  border: 1px solid rgba(130, 210, 175, 0.35);
  color: #9ef0c8;
  pointer-events: none;
  z-index: 6;
}

.app-shell[data-perf-tier="1"] .perf-badge {
  border-color: rgba(245, 200, 90, 0.5);
  color: #ffe08a;
}
.app-shell[data-perf-tier="2"] .perf-badge {
  border-color: rgba(255, 145, 85, 0.6);
  color: #ffb382;
}
.app-shell[data-perf-tier="3"] .perf-badge {
  border-color: rgba(255, 95, 115, 0.7);
  color: #ff9aa8;
}

.toast-banner {
  position: absolute;
  left: 8px;
  right: 8px;
  bottom: 10px;
  padding: 7px 10px;
  border-radius: 10px;
  background: rgba(20, 30, 46, 0.92);
  border: 1px solid rgba(126, 178, 255, 0.35);
  font-size: 12px;
  text-align: center;
  color: #e8f1ff;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
  pointer-events: none;
  z-index: 7;
}

.toast-banner.show {
  opacity: 1;
  transform: translateY(0);
}

.bottom-hud {
  flex: 0 0 auto;
  padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
  background: rgba(16, 23, 34, 0.96);
  border-top: 1px solid rgba(148, 178, 224, 0.2);
  display: flex;
  flex-direction: column;
  gap: 6px;
  z-index: 10;
}

.ctrl-row {
  display: flex;
  gap: 6px;
  width: 100%;
  min-width: 0;
}

button {
  font-family: inherit;
  border: none;
  border-radius: 9px;
  padding: 8px 8px;
  font-size: 12px;
  font-weight: 700;
  color: #eef4ff;
  cursor: pointer;
  min-width: 0;
}

button:disabled {
  opacity: 0.42;
  cursor: not-allowed;
}

.btn-accent {
  flex: 1.2;
  background: #2b6cb0;
}

.btn-toggle {
  flex: 0.9;
  background: #283548;
  border: 1px solid rgba(150, 180, 225, 0.25);
}

.btn-toggle.active {
  background: #235c47;
  border-color: #68d391;
  color: #d8ffea;
}

.btn-secondary {
  flex: 1;
  background: #2b3a52;
  border: 1px solid rgba(150, 180, 225, 0.25);
}

.btn-primary {
  background: #3182ce;
  padding: 8px 12px;
  white-space: nowrap;
}

.btn-icon {
  background: #283548;
  padding: 6px 10px;
}

.speed-group {
  display: flex;
  gap: 3px;
  flex: 1.2;
}

.btn-spd {
  flex: 1;
  padding: 8px 4px;
  background: #222e42;
  border: 1px solid rgba(150, 180, 225, 0.2);
}

.btn-spd.active {
  background: #4a5568;
  border-color: #90cdf4;
  color: #ffffff;
}

.drawer {
  position: absolute;
  inset: 0;
  background: rgba(13, 19, 30, 0.97);
  z-index: 20;
  display: flex;
  flex-direction: column;
  padding: 10px;
  gap: 8px;
  overflow: hidden;
}

.drawer.hidden {
  display: none;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
}

.drawer-header h2 {
  margin: 0;
  font-size: 15px;
}

.drawer-sub {
  margin: 2px 0 0;
  font-size: 11px;
  color: #9fb4d4;
}

.tab-bar {
  display: flex;
  gap: 4px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.tab-btn {
  flex: 1 0 auto;
  padding: 6px 8px;
  font-size: 11px;
  background: #1f2b3e;
  border: 1px solid rgba(148, 178, 224, 0.2);
  white-space: nowrap;
}

.tab-btn.active {
  background: #2b6cb0;
  border-color: #90cdf4;
}

.tree-list, .shop-list {
  flex: 1 1 auto;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-right: 2px;
}

.node-card, .shop-card, .selected-tower-box, .growth-box {
  background: #1a2538;
  border: 1px solid rgba(148, 178, 224, 0.18);
  border-radius: 10px;
  padding: 8px 10px;
}

.node-card.unlocked {
  border-color: rgba(104, 211, 145, 0.55);
  background: #182f2b;
}

.node-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.node-title {
  font-size: 13px;
  font-weight: 700;
}

.node-cost {
  font-size: 11px;
  color: #fbd38d;
  white-space: nowrap;
}

.node-desc {
  margin: 4px 0 6px;
  font-size: 11px;
  color: #c2d1e8;
  line-height: 1.35;
}

.growth-box {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.growth-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 12px;
}

.shop-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.muted {
  color: #96abc9;
  font-size: 12px;
  margin: 0;
}
